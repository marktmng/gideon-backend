# Gideon Backend Configuration Template
APP_NAME=Gideon
APP_ENV=development
DEBUG=true

# Database Configuration
# Default: SQLite file database for immediate local development without external dependencies
DATABASE_URL=sqlite:///./gideon.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gideon

# AI Assistant Provider Configuration
# Set to 'demo' for mock/offline testing (no external keys needed)
AI_PROVIDER=demo
AI_MODEL=
AI_API_KEY=

# Security & CORS
FRONTEND_ORIGIN=http://localhost:3000
API_V1_PREFIX=/api/v1

# Gideon Backend Configuration Template — Phase 2
APP_NAME=Gideon
APP_ENV=development
DEBUG=true

# Database Configuration
# Default: SQLite file database for immediate local development without external dependencies
DATABASE_URL=sqlite:///./gideon.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gideon

# AI Assistant Provider Configuration
# Set to 'demo' for mock/offline testing (no external keys needed)
# Set to 'gemini' to enable real neural AI responses
AI_PROVIDER=demo

# Google Gemini Configuration (when AI_PROVIDER=gemini)
# Acquire an API key from Google AI Studio: https://aistudio.google.com/
# Note: Antigravity IDE subscriptions do not automatically grant external API keys.
GEMINI_API_KEY=
# Fallback key variable also supported:
# AI_API_KEY=

# Supported Gemini models: gemini-2.5-flash (default, fast & multimodal), gemini-3.7-flash, gemini-3.5-flash-lite
AI_MODEL=gemini-2.5-flash

# Generation Parameters & Context Controls
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.7

# Memory Context Retrieval Controls
MEMORY_MAX_RETRIEVAL_COUNT=5

# Security & CORS
FRONTEND_ORIGIN=http://localhost:3000
API_V1_PREFIX=/api/v1
